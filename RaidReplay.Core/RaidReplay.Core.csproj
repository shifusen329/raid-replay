<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RaidReplay.Core</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaidReplay.Core.Tests" />
    <EmbeddedResource Include="Encounters\Packs\*.json" LogicalName="RaidReplay.Core.Packs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
